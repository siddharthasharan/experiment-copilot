_pct": 1.888842233453699, "p_value": 1.2518171174955173e-13, "significant": true}], "flags": [{"severity": "warn", "text": "Cochran's Q=53.4 on 12 df (p=3.49e-07): lifts differ across segments \u2014 decide per segment, not on the average."}, {"severity": "warn", "text": "Credible heterogeneity: US|web, new, other|web survive BH-FDR \u2014 decide per segment, not on the average."}], "segments": [{"segment": "BR|android", "lift_pct": 0.8200928504977919, "ci_low_pct": -0.982417955730356, "ci_high_pct": 2.6226036567259396, "p_value": 0.4671507299225379, "bh_survivor": false, "n": 47289}, {"segment": "BR|ios", "lift_pct": 0.9860264480583922, "ci_low_pct": -0.8581006991990849, "ci_high_pct": 2.830153595315869, "p_value": 0.59655134050506, "bh_survivor": false, "n": 47122}, {"segment": "BR|web", "lift_pct": -0.8325379189077797, "ci_low_pct": -4.658262429224187, "ci_high_pct": 2.9931865914086275, "p_value": 0.2351154293035298, "bh_survivor": false, "n": 10706}, {"segment": "IN|android", "lift_pct": 1.1972521393238316, "ci_low_pct": -0.21748678435005758, "ci_high_pct": 2.6119910629977205, "p_value": 0.6912349491176544, "bh_survivor": false, "n": 78103}, {"segment": "IN|ios", "lift_pct": 0.3104388946755948, "ci_low_pct": -1.0887687362214966, "ci_high_pct": 1.709646525572686, "p_value": 0.08972188333039255, "bh_survivor": false, "n": 78462}, {"segment": "IN|web", "lift_pct": 1.4809216971836159, "ci_low_pct": -1.4916448362665469, "ci_high_pct": 4.453488230633779, "p_value": 0.9955512028061562, "bh_survivor": false, "n": 17438}, {"segment": "US|android", "lift_pct": 1.380527705737612, "ci_low_pct": 0.26207271156088896, "ci_high_pct": 2.498982699914335, "p_value": 0.8631640041791515, "bh_survivor": false, "n": 126342}, {"segment": "US|ios", "lift_pct": 0.5618851746996464, "ci_low_pct": -0.5378680412795869, "ci_high_pct": 1.6616383906788794, "p_value": 0.08203490411201342, "bh_survivor": false, "n": 126088}, {"segment": "US|web", "lift_pct": -2.5221467176479844, "ci_low_pct": -4.